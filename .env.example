# ===========================================================================
# RiskLens AI - Environment Template
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ===========================================================================

# --- Application ---
APP_NAME=RiskLens AI
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL). SQLite fallback for local dev without Postgres.
#   Production: postgresql+psycopg2://postgres:postgres@localhost:5432/risklens
#   Local-only (no Postgres): sqlite:///./risklens.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/risklens

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Bootstrap Admin (created automatically on first startup) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@risklens.ai
ADMIN_PASSWORD=Admin@123456

# --- CORS (React dev server origin) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
