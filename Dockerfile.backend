# =============================================================================
# RiskLens AI - Backend Docker image (FastAPI + uvicorn)
# Multi-stage: build deps in a slim image, run lightweight in final.
# =============================================================================
FROM python:3.10-slim AS base

# Prevent Python from writing .pyc and buffer stdout for container logs
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Copy only requirements first to leverage Docker layer caching
COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy application code
COPY backend/app ./app

EXPOSE 8000

# Run uvicorn without reload in production
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]